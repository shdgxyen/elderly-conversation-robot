ELDER_ROBOT_ENVIRONMENT=development
ELDER_ROBOT_HOST=127.0.0.1
ELDER_ROBOT_PORT=8000
ELDER_ROBOT_LOG_LEVEL=INFO

ELDER_ROBOT_DATABASE_URL=sqlite:///./data/elder_companion.db
ELDER_ROBOT_DATABASE_ECHO=false

# Keep mock for offline development. Select: mock, qwen, or kimi.
ELDER_ROBOT_LLM_BACKEND=mock

# Alibaba Cloud Bailian (DashScope) OpenAI-compatible endpoint.
ELDER_ROBOT_QWEN_API_KEY=
ELDER_ROBOT_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ELDER_ROBOT_QWEN_MODEL=qwen-plus
ELDER_ROBOT_QWEN_MAX_TOKENS=2048
# Qwen3 models reject non-streaming requests unless thinking is off.
ELDER_ROBOT_QWEN_ENABLE_THINKING=false
ELDER_ROBOT_QWEN_CONNECT_TIMEOUT_SECONDS=5.0
ELDER_ROBOT_QWEN_READ_TIMEOUT_SECONDS=60.0

ELDER_ROBOT_KIMI_API_KEY=
ELDER_ROBOT_KIMI_BASE_URL=https://api.moonshot.cn/v1
ELDER_ROBOT_KIMI_MODEL=kimi-k3
ELDER_ROBOT_KIMI_REASONING_EFFORT=low
ELDER_ROBOT_KIMI_MAX_COMPLETION_TOKENS=2048
ELDER_ROBOT_KIMI_CONNECT_TIMEOUT_SECONDS=5.0
ELDER_ROBOT_KIMI_READ_TIMEOUT_SECONDS=60.0
ELDER_ROBOT_STT_BACKEND=mock
ELDER_ROBOT_TTS_BACKEND=mock
ELDER_ROBOT_AUDIO_BACKEND=mock

# Device link is disabled by default. Select: none, serial, or mock_tcp.
ELDER_ROBOT_DEVICE_TRANSPORT=none
ELDER_ROBOT_DEVICE_SERIAL_PORT=/dev/ttyACM0
ELDER_ROBOT_DEVICE_SERIAL_BAUDRATE=115200
ELDER_ROBOT_DEVICE_IO_TIMEOUT_SECONDS=1.0
ELDER_ROBOT_DEVICE_RECONNECT_INTERVAL_SECONDS=1.0
ELDER_ROBOT_DEVICE_MOCK_TCP_HOST=127.0.0.1
ELDER_ROBOT_DEVICE_MOCK_TCP_PORT=8765

ELDER_ROBOT_DEFAULT_USER_ID=default-user
ELDER_ROBOT_DEFAULT_DISPLAY_NAME=访客
